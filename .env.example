# Yellow Go Taxi — Environment Configuration Template
# Copy this file to .env to override default business, routing, or analytics values.

# Business Contact Configuration (Defaults configured in src/config/business.ts)
VITE_BUSINESS_PHONE="+91 99943 53722"
VITE_BUSINESS_WHATSAPP="919994353722"
VITE_BUSINESS_EMAIL=""
VITE_BUSINESS_ADDRESS="Gandhipuram, Coimbatore, Tamil Nadu"
VITE_BUSINESS_HOURS=""
VITE_WEBSITE_URL="https://yellowgotaxi.com"

# Optional Mapping / Routing Provider Configuration
VITE_MAPS_PROVIDER="osrm"
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Google Analytics 4 & Google Ads Conversion Tracking
VITE_GA4_MEASUREMENT_ID=""
VITE_GOOGLE_ADS_CONVERSION_ID=""
VITE_GOOGLE_ADS_WHATSAPP_LABEL=""
VITE_GOOGLE_ADS_PHONE_LABEL=""
VITE_GOOGLE_ADS_BOOKING_LABEL=""

# Optional Asset Debug Mode (set to "true" during local dev to inspect asset filenames)
VITE_ASSET_DEBUG="false"
